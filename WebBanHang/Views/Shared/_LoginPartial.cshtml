@using Microsoft.AspNetCore.Identity
@using WebBanHang.Utilitys

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<div class="wrap-icon-header flex-w flex-r-m">
@if (SignInManager.IsSignedIn(User))
{
    <div class="icon-header-item cl2 hov-cl1 trans-04 p-l-22 p-r-11">
            <a id="manage" class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Manage/Index" title="@UserManager.GetUserName(User)!"><i class="bi bi-person-circle" style="font-size: 25px"></i></a>
    </div>
        <div class="icon-header-item cl2 hov-cl1 trans-04 p-l-22 p-r-11">
        <form id="logoutForm" class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                <button id="logout" type="submit" class="nav-link btn btn-link text-dark border-0"><i class="bi bi-box-arrow-right" title="Logout" style="font-size: 25px"></i></button>

        </form>
    </div>
}
else
{
    <div>
        <a class="nav-link text-dark" id="register" asp-area="identity" asp-page="/account/register">đăng ký</a>
    </div>
    <div>
        <a class="nav-link text-dark" id="login" asp-area="identity" asp-page="/account/login">đăng nhập</a>
    </div>

}
</div>



