@* @model WebBanHang.Models.Product *@
@model WebBanHang.ViewModel.ProductDetailsReviewModel
@{
    ViewData["Title"] = "Display";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@await Component.InvokeAsync("Navbar")
@await Component.InvokeAsync("NavbarBrand")
<br />
<form method="post">

    <div class=" container">
        @if (!string.IsNullOrEmpty(Model.Product.ImageUrl))
        {
            <div class="row">
                <div class="col-5">
                    <img src="@Model.Product.ImageUrl" alt="Product Image" style="max-width: 500px;" />
                </div>
                <div class="col-6">
                    <h1 class="text-dark-50">@Model.Product.Name</h1><br />
                    <h5>Chi tiết sản phẩm</h5>

                    <h6 class="text-muted">@Model.Product.Description</h6><br />
                    <div class="col-12 col-md-6 pb-1">
                        <h5 class="text-danger h2 pb-2">Giá:@Model.Product.Price.ToString("c")</h5>
                        <p style="font-size: 25px; color: #ffd700;">@Model.AverageRating.ToString("0.0") &#9733;</p>
                        @if (Model.Product.Stock > 0)
                            {
                                <p>Số lượng: @Model.Product.Stock</p>

                                <form method="post">
                                    <input type="hidden" name="productId" value="@Model.Product.Id" />
                                    <input class="col-3 transition form-outline-success form-control" style="width: 100px" type="number" name="quantity" value="1" min="1" max="@Model.Product.Stock" />
                                    <button asp-action="AddToCart" asp-controller="ShoppingCart" type="submit" class="col-7 transition btn btn-outline-success" style="height:38px">
                                        Add to Cart
                                    </button>
                                </form>
                            }
                            else
                            {
                                <p style="color: red;">Hết hàng</p>
                                <button class="col-7 transition  bor4 pointer" style="height:38px" disabled style="background-color: gray; cursor: not-allowed;">Add to Cart</button>
                            }
                        
                    </div>
                </div>
            </div>
        }
    </div>
</form>


<div class="product-comments">
    <div class="comment">
        <h3 style="text-align: center">Đánh giá & Nhận xét @Model.Product.Name</h3>
        <div class="row">
            <div class="col-5">
                <div class="average-rating">
                    <div>
                        <span style="font-size: 50px; color: red">@Model.AverageRating.ToString("0.0") / 5</span>
                    </div>
                    <div>
                        @for (int i = 1; i <= 5; i++)
                        {
                            <span class="star @(i <= Math.Round(Model.AverageRating) ? "selected" : "")">&#9733;</span>
                        }
                    </div>
                </div>
            </div>
            <div class="col-7">
                <div class="rating-statistics">
                    @for (int i = 5; i >= 1; i--)
                    {
                        <div class="rating-stat">
                                <span class="star" style="font-size: 25px; color: #ffd700;">@i &#9733</span>
                            <div class="progress-bar">
                                <div class="progress" style="width:@(Model.Comments.Count > 0 ? Model.RatingCounts[i] * 100 / Model.Comments.Count : 0)%"></div>
                            </div>
                                <span class="rating-count">@Model.RatingCounts[i] đánh giá</span>
                        </div>
                    }
                </div>
            </div>

        </div><hr />


    
        @foreach (var comment in Model.Comments)
        {
            <div>
                <div class="comment-header">
                    <strong>@comment.UserName</strong> <span>@comment.CommentDate.ToLocalTime()</span>
                </div>
                <div class="comment-body">
                    <p>@comment.Content</p>
                    <div class="star-rating">
                        @for (int i = 1; i <= 5; i++)
                        {
                            <span class="star @(i <= comment.Rating ? "selected" : "")">&#9733;</span>
                        }
                    </div>
                </div>
                @if (comment.Replies != null)
                {
                    <div class="replies">
                        @foreach (var reply in comment.Replies)
                        {
                            <div class="reply">
                                <strong>@reply.UserName</strong> <span>@reply.CommentDate.ToLocalTime()</span>
                                <p>@reply.Content</p>
                            </div><hr />
                        }
                    </div>
                }
                @if (User.Identity.IsAuthenticated)
                {
                    <form asp-action="Create" asp-controller="Comment" method="post" class="reply-form">
                        <input type="hidden" name="productId" value="@Model.Product.Id" />
                        <input type="hidden" name="parentCommentId" value="@comment.Id" />
                        <textarea class="comment" name="content" placeholder="Reply to this comment" required></textarea>
                        <button type="submit">Reply</button>
                    </form>
                }<hr />
            </div>
        }
    </div>

    @if (User.Identity.IsAuthenticated)
    {
        <div class="comment">
            <div class="add-comment">
                <h2>Add a Comment</h2>
                <form asp-action="Create" asp-controller="Comment" method="post">
                    <input type="hidden" name="productId" value="@Model.Product.Id" />
                    <textarea class="comment" name="content" placeholder="Add your comment" required></textarea>
                    <div class="star-rating">
                        <input type="hidden" name="rating" id="rating" value="0" />
                        <span class="star" data-value="5">&#9733;</span>
                        <span class="star" data-value="4">&#9733;</span>
                        <span class="star" data-value="3">&#9733;</span>
                        <span class="star" data-value="2">&#9733;</span>
                        <span class="star" data-value="1">&#9733;</span>
                    </div>
                    <button type="submit">Submit</button>
                </form>
            </div>
        </div>

    }
    else
    {
        <p>You must be logged in to add a comment.</p>
    }
</div>
    </<div>
   

@section Scripts {
    <script>
        document.querySelectorAll('.star-rating .star').forEach(function (star) {
            star.addEventListener('click', function () {
                var rating = this.getAttribute('data-value');
                document.getElementById('rating').value = rating;

                // Clear previous selected stars
                this.parentNode.querySelectorAll('.star').forEach(function (star) {
                    star.classList.remove('selected');
                });

                // Add selected class to the clicked star and previous stars
                this.classList.add('selected');
                var nextSibling = this.nextElementSibling;
                while (nextSibling) {
                    nextSibling.classList.add('selected');
                    nextSibling = nextSibling.nextElementSibling;
                }
            });
        });

        document.addEventListener('DOMContentLoaded', function () {
            var rating = document.getElementById('rating').value;
            if (rating > 0) {
                var stars = document.querySelectorAll('.star-rating .star');
                for (var i = 5; i >= rating; i--) {
                    stars[i - 1].classList.add('selected');
                }
            }
        });
    </script>
}

<style>
    .comment, .reply {
        border: 1px solid #ddd;
        padding: 10px;
        margin-bottom: 10px;
        border-radius: 5px;
    }

    .comment-header, .reply-header {
        font-weight: bold;
        margin-bottom: 5px;
    }

    .comment-body, .reply-body {
        margin-bottom: 10px;
    }

    .replies {
        margin-left: 20px;
            background: #ddd;
    }

    .reply-form {
        margin-top: 10px;
        
    }

    .add-comment {
        margin-top: 20px;
    }

        .add-comment form {
            display: flex;
            flex-direction: column;
        }

        .add-comment textarea, .reply-form textarea {
            width: 100%;
            padding: 10px;
            margin-bottom: 10px;
        }

        .add-comment button, .reply-form button {
            align-self: flex-start;
            padding: 10px 20px;
            background-color: #007bff;
            color: white;
            border: none;
            border-radius: 5px;
            cursor: pointer;
        }

        .add-comment button:hover, .reply-form button:hover {
                background-color: #0056b3;
        }

        .star-rating{
        display: flex;
        margin-bottom: 10px;
            }

        .star {
            font-size: 2em;
            cursor: pointer;
            color: #ddd;
         }

        .star.selected {
            color: #ffd700;
        }

        .average-rating{
            display: block;
            position: absolute;
            right: 200px;
            bottom: 100px;
        }

        .rating-statistics {
            margin-top: 20px;
        }

        .rating-stat {
            display: flex;
            align-items: center;
            margin-bottom: 10px;
        }

        .progress-bar {
            flex: 1;
            height: 20px;
            background-color: #f3f3f3;
            border-radius: 5px;
            overflow: hidden;
        }

        .progress {
            height: 100%;
            background-color: #ffd700;
            border-radius: 5px 0 0 5px;
        }

</style>