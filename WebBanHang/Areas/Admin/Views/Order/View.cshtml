
@{
    ViewData["Title"] = "View";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<h1>Chi tiết đơn hàng</h1>

<section class="content">
    <div class="card">
        <div class="card-body">
            <div class="row">
                <div class="col-md-4">
                    <div class="form-group">
                        <label>Id</label>
                        <p class="form-control">@Model.Id</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label>User name</label>
                        <p class="form-control">@Model.Name</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label>Phone number</label>
                        <p class="form-control">@Model.PhoneNumber</p>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-4">
                    <div class="form-group">
                        <label>Price</label>
                        <p class="form-control">@Model.TotalPrice.ToString("c")</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label>Order date</label>
                        <p class="form-control">@Model.OrderDate.ToString("dd/MM/yyyy")</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label>Shipping Address</label>
                        <p class="form-control">@Model.ShippingAddress</p>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12">
                    <div class="form-group">
                        <label>Note</label>
                        <p class="form-control">@Model.Notes</p>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12">
                   <h2>Chi tiết sản phẩm</h2>
                   
                </div>
            </div>
        </div>
    </div>

</section>