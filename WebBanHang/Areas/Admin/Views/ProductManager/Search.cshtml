@model IEnumerable<WebBanHang.Models.Product>
@{
    ViewData["Title"] = "Search";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
    Pager pager = new Pager();
    int pageNo = 0;
    if (ViewBag.Pager != null)
    {
        pager = ViewBag.Pager;
        pageNo = pager.Currentpage;
    }
}

<h2>Sản Phẩm</h2>
<div class="navbar-collapse collapse d-sm-inline-flex justify-content-end input-group col-6" style="height:50px">
    <form class="d-flex" asp-action="Search" asp-controller="Product">
        <input name="searchString" type="search" class="form-control rounded" placeholder="Search" aria-label="Search" aria-describedby="search-addon" />
        <button type="submit" class="btn btn-outline-dark" data-mdb-ripple-init>search</button>
    </form>

</div>

<Nav>
    <div class=" navbar-collapse collapse d-sm-inline-flex justify-content-between">
        <a asp-action="Index" asp-controller="Product" class="btn btn-primary">Back to default <i class="bi bi-arrow-return-left"></i></a>
    </div>

    <div class="navbar-collapse collapse d-sm-inline-flex justify-content-end">

        <a asp-controller="Product" asp-action="Add" class="btn btn-primary"><i class="bi bi-plus-square"></i> Add Products</a>
    </div>
</Nav>
<table class="table">
    <thead>
        <tr>
            <th><a asp-action="Search" asp-controller="Product" asp-route-sortOrder="@ViewData["NameSortParam"]">Name <i class="bi bi-arrow-down-up"></i></a></th>
            <th><a asp-action="Search" asp-controller="Product" asp-route-sortOrder="@ViewData["PriceSortParam"]">Price <i class="bi bi-arrow-down-up"></i></a></th>
            <th>Description</th>
            <th>Category</th>
            <th>Brand</th>
            <th>Image</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var product in Model)
        {
            <tr>
                <td>@product.Name</td>
                <td>@product.Price</td>
                <td>@product.Description</td>
                <td>@product.Category?.Name</td>
                <td>@product.Brand?.Name</td>
                <td><img src="@product.ImageUrl" style="max-width: 100px;" /></td>
                <td class="btn-group" role="group" aria-label="Basic example">
                    <a asp-action="Display" class="btn btn-primary btn-sm" asp-route-id="@product.Id">View</a> |
                    <a asp-action="Update" class="btn btn-primary btn-sm" asp-route-id="@product.Id">Edit</a> |
                    <a asp-action="Delete" class="btn btn-primary btn-sm" asp-route-id="@product.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
<div class="container">
    @if (pager.TotalPages > 0)
    {
        <ul class="pagination justify-content-center">
            @if (pager.Currentpage > 1)
            {
                <li class="page-item">
                    <a class="page-link" asp-controller="Product" asp-action="Index" asp-route-pg="1">First</a>
                </li>
                <li class="page-item">
                    <a class="page-link" asp-controller="Product" asp-action="Index" asp-route-pg="@(pager.Currentpage - 1)">Previous</a>
                </li>
            }

            @for (var pge = pager.StartPage; pge <= pager.EndPage; pge++)
            {
                <li class="page-item @(pge == pager.Currentpage ? "active" : "")">
                    <a class="page-link" asp-controller="Product" asp-action="Index" asp-route-pg="@pge">@pge</a>
                </li>
            }

            @if (pager.Currentpage < pager.TotalPages)
            {
                <li class="page-item">
                    <a class="page-link" asp-controller="Product" asp-action="Index" asp-route-pg="@(pager.Currentpage + 1)">Next</a>
                </li>
                <li class="page-item">
                    <a class="page-link" asp-controller="Product" asp-action="Index" asp-route-pg="@(pager.TotalPages)">Last</a>
                </li>
            }

        </ul>
    }

</div>

