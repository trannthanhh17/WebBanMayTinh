@model WebBanHang.Models.Product
@{
    ViewData["Title"] = "Display";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}
<h2 class="text-center my-4">Thông Tin Sản Phẩm</h2>

<div class="container bg-light p-4 rounded shadow-sm">
    @if (!string.IsNullOrEmpty(Model.ImageUrl))
    {
        <div class="row align-items-center">
            <div class="col-md-6 text-center mb-4 mb-md-0">
                <img src="@Model.ImageUrl" alt="Product Image" class="img-fluid rounded" style="max-width: 100%;" />
            </div>
            <div class="col-md-6">
                <h1 class="text-dark">@Model.Name</h1>
                <h5 class="text-secondary mb-3">Chi tiết sản phẩm</h5>
                <p class="text-muted">@Model.Description</p>
                <h5 class="text-danger h2">Giá: @Model.Price.ToString("c")</h5>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-warning" role="alert">
            Không có hình ảnh sản phẩm để hiển thị.
        </div>
    }
</div>
