@model WebBanHang.Models.EditUserRolesViewModel

@{
    ViewData["Title"] = "Chỉnh sửa vai trò người dùng";
}

<h2>Chỉnh sửa vai trò người dùng</h2>

<form asp-action="EditRoles" method="post">
    <input type="hidden" asp-for="UserId" />
    <div class="form-group">
        <label asp-for="Email"></label>
        <input type="email" asp-for="Email" class="form-control" readonly />
    </div>
    <div class="form-group">
        <label for="roles">Chọn vai trò:</label>
        <select id="roles" name="SelectedRoles" class="form-control" multiple="multiple">
            @foreach (var role in Model.AllRoles)
            {
                var selected = Model.UserRoles.Contains(role) ? "selected=\"selected\"" : "";
                @Html.Raw($"<option value=\"{role}\" {selected}>{role}</option>");
            }
        </select>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
</form>
